{
  "name": "mg-platform",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && biome check . && node tooling/check-platform.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats": "node tooling/count-lines.ts",
    "new:game": "node tooling/create-game-repo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
